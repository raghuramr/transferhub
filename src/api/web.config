<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure App Service (Windows) hosts the compiled NestJS app via
  httpPlatformHandler instead of iisnode: iisnode produced zero entries
  in LogFiles\iisnode across repeated requests and every request 404'd
  before reaching Node, which points at iisnode not being registered on
  this Node ~24 stack image (a legacy, community-maintained module
  Microsoft has been phasing out on newer Windows App Service Node
  runtimes). httpPlatformHandler is IIS's first-party module for
  proxying to a custom process and needs no such module to be present.

  It just spawns `node dist/main.js`, waits for it to bind
  %HTTP_PLATFORM_PORT%, and forwards every request straight through.
  No URL Rewrite rules are needed: NestJS's own ServeStaticModule
  (see app.module.ts) already serves the React SPA from public/.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="node"
                   arguments="&quot;%HOME%\site\wwwroot\dist\main.js&quot;"
                   startupTimeLimit="120"
                   startupRetryCount="3"
                   stdoutLogEnabled="true"
                   stdoutLogFile="%HOME%\LogFiles\httpplatform-stdout">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
