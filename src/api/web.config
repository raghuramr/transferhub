<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure App Service (Windows) requires this web.config to route all
  incoming requests through iisnode to our Node.js entry point.
  iisnode is pre-installed on all Windows Azure App Service instances.
-->
<configuration>
  <system.webServer>
    <!-- Entry point: the compiled NestJS bundle -->
    <handlers>
      <add name="iisnode" path="dist/main.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Serve static files (React SPA assets) directly from public/ -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="^(assets|favicon\.ico|.*\.(js|css|png|svg|ico|woff2?|ttf|map))$" />
          <action type="Rewrite" url="public/{R:0}" />
        </rule>
        <!-- Route all other requests through the Node.js app -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="dist/main.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Disable directory browsing -->
    <directoryBrowse enabled="false" />

    <iisnode
      node_env="%NODE_ENV%"
      nodeProcessCommandLine="node"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
    />
  </system.webServer>
</configuration>
