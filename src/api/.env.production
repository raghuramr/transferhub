# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION environment — update DB_SERVER / DB_NAME only
# All other values should be set as real secrets in your hosting environment
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── SQL Server (Windows Auth — change DB_SERVER to your prod SQL Server instance)
# For a named instance:  DB_SERVER=MYSERVER\SQLEXPRESS
# For default instance:  DB_SERVER=MYSERVER
# For LocalDB:           DB_SERVER=(localdb)\MSSQLLocalDB
DB_SERVER=(localdb)\MSSQLLocalDB
DB_PORT=
DB_NAME=CreditEvalManager
DB_TRUSTED_CONNECTION=true
DB_ENCRYPT=false
DB_USER=
DB_PASSWORD=

# ── JWT  (REPLACE with real secret — 64+ random hex chars)
JWT_SECRET=REPLACE_WITH_PRODUCTION_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Anthropic
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY
ANTHROPIC_MODEL=claude-opus-4-5

# ── API Server
PORT=3001
CORS_ORIGIN=https://YOUR_PRODUCTION_UI_DOMAIN

# ── Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
