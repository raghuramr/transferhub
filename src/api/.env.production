# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION environment — Azure SQL Database + cloud hosting (Render/Vercel)
# All REPLACE_* values must be set as real secrets in your hosting provider's
# environment variable settings (Render dashboard, etc.) — never commit real
# secrets here. See DEPLOYMENT.md at the repo root for the full walkthrough.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Azure SQL Database ─────────────────────────────────────────────────────
# Azure SQL uses standard SQL login + TLS over TCP — no special driver needed
# (unlike LocalDB). DB_SERVER is your server's full hostname, e.g.:
#   myserver.database.windows.net
DB_SERVER=codecrafterstransferhub.database.windows.net
DB_PORT=1433
DB_NAME=TransferHubDB
DB_TRUSTED_CONNECTION=false
DB_ENCRYPT=true              # REQUIRED by Azure SQL — also flips off cert-trust bypass
DB_USER=REPLACE_WITH_SQL_ADMIN_LOGIN
DB_PASSWORD=REPLACE_WITH_SQL_ADMIN_PASSWORD
DB_DRIVER=tedious            # plain TCP driver — correct for Azure SQL (not msnodesqlv8)

# ── JWT  (REPLACE with a real secret — 64+ random hex chars) ───────────────
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=evoke-technologies-secret-key-clopay-code-crafters-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY
ANTHROPIC_MODEL=claude-opus-4-5

# ── API Server ────────────────────────────────────────────────────────────────
# Render/Railway/etc. inject their own PORT at runtime — this is just a
# local fallback default and is safely overridden.
PORT=3001
CORS_ORIGIN=https://REPLACE_WITH_YOUR_VERCEL_DOMAIN

# ── Security ──────────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15
