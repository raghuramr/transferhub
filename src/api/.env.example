# ─────────────────────────────────────────────────────────────────────────────
# University Transfer Credit Evaluation — API Environment Template
#
# Copy this file to .env (development), .env.test, or .env.production
# and fill in the values for your environment.
# NEVER commit a file with real secrets to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=development        # development | test | production

# ── SQL Server ───────────────────────────────────────────────────────────────
# Windows Integrated Auth (LocalDB or domain SQL Server) — recommended:
#   DB_SERVER=(localdb)\MSSQLLocalDB
#   DB_TRUSTED_CONNECTION=true
#   DB_USER=   (leave blank)
#   DB_PASSWORD= (leave blank)
#
# SQL login (Docker dev or remote server with SQL auth):
#   DB_SERVER=localhost
#   DB_PORT=1433
#   DB_USER=sa
#   DB_PASSWORD=YourStrong!Passw0rd
#   DB_TRUSTED_CONNECTION=false

DB_SERVER=(localdb)\MSSQLLocalDB
DB_PORT=                    # leave blank for LocalDB / named instance
DB_NAME=CreditEvalManager
DB_TRUSTED_CONNECTION=true  # true = Windows Auth (no user/password needed)
DB_ENCRYPT=false            # true for Azure SQL / TLS-enforced servers
DB_USER=                    # only needed when DB_TRUSTED_CONNECTION=false
DB_PASSWORD=                # only needed when DB_TRUSTED_CONNECTION=false

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=evoke-technologies-secret-key-clopay-code-crafters
JWT_ACCESS_EXPIRY=15m       # short-lived access token
JWT_REFRESH_EXPIRY=7d       # long-lived refresh token (stored hashed)

# ── Anthropic AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY
ANTHROPIC_MODEL=claude-opus-4-5

# ── API Server ────────────────────────────────────────────────────────────────
PORT=3001
CORS_ORIGIN=http://localhost:5173   # UI dev server

# ── Security ──────────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5        # attempts before account lockout
LOCKOUT_MINUTES=15          # lockout duration
