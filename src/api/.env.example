# ─────────────────────────────────────────────────────────────────────────────
# University Transfer Credit Evaluation — API Environment Template
#
# Copy this file to .env (development), .env.test, or .env.production
# and fill in the values for your environment.
# NEVER commit a file with real secrets to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=development        # development | test | production

# ── SQL Server ───────────────────────────────────────────────────────────────
# IMPORTANT: Node's default SQL driver (tedious) only speaks TCP. It CANNOT
# connect to "(localdb)\..." directly — that's a named-pipe connection, the
# same kind sqlcmd/SSMS use, not a network hostname. If you use LocalDB you
# MUST also set DB_DRIVER=msnodesqlv8 below (see note on that setting).
#
# Option A — LocalDB with Windows Integrated Auth (requires DB_DRIVER=msnodesqlv8):
#   DB_SERVER=(localdb)\MSSQLLocalDB
#   DB_TRUSTED_CONNECTION=true
#   DB_DRIVER=msnodesqlv8
#   DB_USER= / DB_PASSWORD=   (leave blank)
#
# Option B — Real SQL Server / SQL Express with TCP/IP enabled (no extra driver needed):
#   DB_SERVER=localhost
#   DB_PORT=1433
#   DB_TRUSTED_CONNECTION=true   (Windows Auth) or false + DB_USER/DB_PASSWORD (SQL login)
#   DB_DRIVER=tedious  (or just leave DB_DRIVER unset)

DB_SERVER=(localdb)\MSSQLLocalDB
DB_PORT=                    # leave blank for LocalDB / named instance
DB_NAME=TransferHubDB
DB_TRUSTED_CONNECTION=true  # true = Windows Auth (no user/password needed)
DB_ENCRYPT=false            # true for Azure SQL / TLS-enforced servers
DB_USER=                    # only needed when DB_TRUSTED_CONNECTION=false
DB_PASSWORD=                # only needed when DB_TRUSTED_CONNECTION=false

# DB_DRIVER: "tedious" (default, TCP only) or "msnodesqlv8" (native Windows
# driver — REQUIRED for "(localdb)\..." servers). If set to msnodesqlv8, run
# "npm install msnodesqlv8" once first (compiles a native addon).
DB_DRIVER=msnodesqlv8

# DB_ODBC_DRIVER: only used when DB_DRIVER=msnodesqlv8. Must exactly match an
# ODBC driver installed on this machine, or you'll get:
#   "[Microsoft][ODBC Driver Manager] Data source name not found..."
# Find installed drivers in PowerShell:  Get-OdbcDriver | Select-Object Name
# SSMS 19+ typically installs "ODBC Driver 17 for SQL Server" or
# "ODBC Driver 18 for SQL Server" (older SNAC "SQL Server Native Client 11.0"
# is no longer bundled with modern SSMS).
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=evoke-technologies-secret-key-clopay-code-crafters
JWT_ACCESS_EXPIRES=15m       # short-lived access token
JWT_REFRESH_EXPIRES=7d       # long-lived refresh token (stored hashed)

# ── Anthropic AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY
ANTHROPIC_MODEL=claude-opus-4-5

# ── API Server ────────────────────────────────────────────────────────────────
PORT=3001
CORS_ORIGIN=http://localhost:5173   # UI dev server

# ── Security ──────────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5        # attempts before account lockout
LOCK_DURATION_MINUTES=15          # lockout duration

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Used to send welcome and status-update emails. Optional in local dev.
# If unset, EmailService logs a warning and no-ops.
RESEND_API_KEY=
RESEND_FROM_EMAIL=support@wcubeprojects.in
RESEND_FROM_NAME=TransferHub
APP_BASE_URL=https://transferhub.azurewebsites.net

# ── Azure Blob Storage (uploaded documents) ─────────────────────────────────
# Leave AZURE_STORAGE_CONNECTION_STRING blank in local dev to fall back to
# ./storage on disk. REQUIRED in production (App Service disk is ephemeral).
# Private container: one folder per user, files served only via the API.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_PRIVATE=student-documents
AZURE_STORAGE_CONTAINER_PUBLIC=public-assets
