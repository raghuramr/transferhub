{
  "name": "university-manager-api",
  "version": "1.0.0",
  "description": "University Transfer Credit Evaluation API",
  "main": "dist/main.js",
  "scripts": {
    "setup:env": "tsx scripts/setup-env.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "seed:users:test": "cross-env NODE_ENV=test tsx scripts/seed-users.ts",
    "seed:users:prod": "cross-env NODE_ENV=production tsx scripts/seed-users.ts",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "start:prod": "node dist/main"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/throttler": "^6.4.0",
    "argon2": "^0.43.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "mssql": "^11.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.8.0",
    "rxjs": "^7.8.1",
    "tedious": "^18.6.1",
    "uuid": "^11.0.5"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^4.5.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.1",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.13.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
