# ─────────────────────────────────────────────────────────────────────────────
# TEST environment — update DB_NAME / DB_SERVER only if your test DB differs
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=test

# ── SQL Server (Windows Auth — update DB_SERVER / DB_NAME to match your setup)
DB_SERVER=codecrafterstransferhub.database.windows.net
DB_PORT=1433
DB_NAME=TransferHubDB
DB_TRUSTED_CONNECTION=false
DB_ENCRYPT=true              # REQUIRED by Azure SQL — also flips off cert-trust bypass
DB_USER=codecrafters
DB_PASSWORD=September@2026
# "(localdb)\..." requires msnodesqlv8 (tedious is TCP-only) — see .env.example
DB_DRIVER=msnodesqlv8
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# ── JWT
JWT_SECRET=evoke-technologies-secret-key-clopay-code-crafters-test
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Anthropic
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY
ANTHROPIC_MODEL=claude-haiku-4-5

# ── API Server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── Security
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15
