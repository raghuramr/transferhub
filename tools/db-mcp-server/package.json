{
  "name": "transferhub-db-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that applies TransferHub's database migrations/seeds (database/migrations, database/seed) to SQL Server or Azure SQL, as callable tools for any MCP client.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "transferhub-db-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.5",
    "mssql": "^11.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
